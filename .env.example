# Copy this file to .env to change the ports DevOps Labs uses on your machine.
# The web app:
DEVOPS_LABS_PORT=8800
# Web interfaces of the add-on services (only used while a lab needs them):
DEVOPS_LABS_GITEA_PORT=8801
DEVOPS_LABS_GRAFANA_PORT=8802
DEVOPS_LABS_PROMETHEUS_PORT=8803
DEVOPS_LABS_ARGOCD_PORT=8804
